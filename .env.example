# ==============================================================================
# Papan Peta Intelijen Kejaksaan Negeri Tabanan - Environment Variables
# ==============================================================================

# AUTENTIKASI LOGIN APLIKASI (Set di .env lokal atau Environment Variables Vercel)
# Digunakan oleh endpoint server-side /api/login (jangan beri prefix VITE_)
USER_LOGIN="admin@kejari-tabanan.go.id"
USER_PASS=""

# SUPABASE CONFIGURATION (Opsional jika menggunakan database Supabase)
# Dapatkan dari Dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# DATA PERKARA ADAPTER (CMS PUBLIK KEJAKSAAN RI - SATKER 22.08.00)
# Endpoint resmi Kejari Tabanan (dilengkapi proteksi Anti-Downtime & Caching):
PERKARA_PROVIDER="api"
PERKARA_API_URL="https://cms-publik.kejaksaan.go.id/api/pidum/filtered?tahun=2026&satker=22.08.00"
PERKARA_SATKER="22.08.00"

# VITE CLIENT-SIDE EXPOSURE FOR PROVIDER
VITE_PERKARA_PROVIDER="api"

# APP_URL: URL host aplikasi (otomatis diisi di Vercel atau Cloud Run)
APP_URL="http://localhost:3000"
